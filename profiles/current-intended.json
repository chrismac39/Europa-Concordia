    {
      "id": "mrc-historical-defaults-no-cmm",
      "sourcePath": "integration/overrides/more-restricted-colonization/in_game/common/on_action/MRC_cmm_on_actions.txt",
      "targetPath": "in_game/common/on_action/MRC_cmm_on_actions.txt",
      "targetPackageId": "more-restricted-colonization",
      "resolutionType": "merged-patch",
      "reason": "The EU5 on_action directory does not support database entry injection. This complete, authored replacement preserves MRC's historical-default initialization and removes only its CMF/CMM registration and callback hooks.",
      "preserves": [
        "on_game_start",
        "on_game_load",
        "MRC_init_safe_defaults",
        "mrc_historical_bypass",
        "mrc_tax_threshold"
      ],
      "suppresses": [
        "cmf_on_mod_registration",
        "cmf_on_callback",
        "MRC_register_cmf_mod",
        "MRC_sync_menu_to_globals"
      ]
    }
  ],
