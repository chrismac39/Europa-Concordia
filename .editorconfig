root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf

[packages/**/{in_game,main_menu}/**/*.{txt,gui}]
charset = utf-8-bom
indent_style = tab

[packages/**/{in_game,main_menu}/**/localization/**/*.yml]
charset = utf-8-bom
indent_style = space
indent_size = 1

[integration/{patches,overrides}/**/{in_game,main_menu}/**/*.{txt,gui}]
charset = utf-8-bom
indent_style = tab

[integration/{patches,overrides}/**/{in_game,main_menu}/**/localization/**/*.yml]
charset = utf-8-bom
indent_style = space
indent_size = 1

[sources/steam-workshop/**/{in_game,main_menu}/**/*.{txt,gui}]
charset = utf-8-bom
indent_style = tab

[sources/steam-workshop/**/{in_game,main_menu}/**/localization/**/*.yml]
charset = utf-8-bom
indent_style = space
indent_size = 1
